# 复制为 .env 后填写：cp env.example .env
# 不要把填好的 .env 提交到仓库。

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# 登录账号（建议用邮箱格式）
DSH_SERVER_ACCOUNT=owner@example.com

# 登录密码，至少 12 字符；可用 openssl rand -base64 24 生成
DSH_SERVER_PASSWORD=change-me-to-a-long-random-password

# 浏览器实际访问的 origin，必须完全一致（含 https 和端口）
DSH_SERVER_PUBLIC_URL=https://remote.example.com

# 可选：反向代理在 Server 容器内看到的 peer IP，用于按真实客户端 IP 限流。
# 不填时所有请求共用一个限流桶；填错会导致请求 400。
# 通常是 Docker 网关（如 172.17.0.1）或代理容器 IP，可用 docker network inspect 查看。
DSH_SERVER_TRUSTED_PROXY_IPS=

# ---------------------------------------------------------------------------
# STUN / TURN
# ---------------------------------------------------------------------------

# 下发给 Host/Client 的 STUN/TURN 地址。客户端必须能访问这些地址。
# 使用自己的 TURN 域名时，注意 DNS 要解析到 TURN_EXTERNAL_IP。
# 不需要 TURN 时，清空 TURN_URLS 和 TURN_SECRET 即可退回 Relay-only。
DSH_SERVER_STUN_URLS=stun:turn.example.com:3478
DSH_SERVER_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp

# coturn REST API 共享密钥，必须与 coturn 的 static-auth-secret 一致。
# 生成：openssl rand -hex 32
# 注意：不要包含 $ 等会被 Compose 插值的字符。
DSH_SERVER_TURN_SECRET=change-me-to-a-long-random-secret
DSH_SERVER_TURN_TTL_SECONDS=300

# coturn 参数
# 云主机/1:1 NAT 必须填公网 IP；物理机直接有公网 IP 时也填该 IP。
TURN_EXTERNAL_IP=203.0.113.10
TURN_REALM=dsh-remote
